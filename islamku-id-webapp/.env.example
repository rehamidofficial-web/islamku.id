# Salin file ini menjadi ".env" lalu isi nilainya. JANGAN commit / bagikan file .env.

# Wajib: connection string dari Neon Console (tombol Connect)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=verify-full
PORT=3000

# Opsional: kirim email dari form kontak. Kosongkan 3 baris SMTP_* jika belum dipakai.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_RECEIVER_EMAIL=emailkamu@example.com
